<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="16dp">

        <TextView
            android:id="@+id/deviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:paddingBottom="8dp"
            android:text="device" />

        <TextView
            android:id="@+id/permissionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:typeface="monospace"
            android:text="permissions" />

        <TextView
            android:id="@+id/metricsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:typeface="monospace"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="capture stopped" />

        <Button
            android:id="@+id/permissionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRANT PERMISSIONS" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START CAPTURE" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOP CAPTURE" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="#40000000" />

        <Button
            android:id="@+id/mark1Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MARK STEP 1 - no call, silent" />

        <Button
            android:id="@+id/mark2Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MARK STEP 2 - no call, I speak" />

        <Button
            android:id="@+id/mark3Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MARK STEP 3 - call, REMOTE speaks" />

        <Button
            android:id="@+id/mark4Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MARK STEP 4 - call, I speak" />

        <Button
            android:id="@+id/mark5Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MARK STEP 5 - call ended, silent" />

    </LinearLayout>
</ScrollView>
